{
  "name": "monorepo-networker",
  "version": "2.1.0",
  "description": "A library designed to facilitate the maintenance of networking code in monorepos",
  "author": {
    "name": "Taha Anılcan Metinyurt - iGoodie",
    "url": "https://github.com/iGoodie",
    "email": "igoodie@programmer.net"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CoconutGoodie/monorepo-networker.git"
  },
  "bugs": {
    "url": "https://github.com/CoconutGoodie/monorepo-networker/issues"
  },
  "keywords": [
    "ipc",
    "abstraction",
    "network",
    "message",
    "listener"
  ],
  "type": "module",
  "main": "./dist/monorepo-networker.umd.cjs",
  "module": "./dist/monorepo-networker.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/monorepo-networker.js",
      "require": "./dist/monorepo-networker.umd.cjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.62.0",
    "@types/node": "^18.15.11",
    "typescript": "^4.9.3",
    "vite": "^4.2.0",
    "vite-plugin-dts": "^2.1.0"
  }
}
