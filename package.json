{
  "name": "monorepo-networker",
  "version": "2.1.0",
  "description": "A library designed to facilitate the maintenance of networking code in monorepos",
  "author": {
    "name": "Taha Anılcan Metinyurt - iGoodie",
    "url": "https://github.com/iGoodie",
    "email": "igoodie@programmer.net"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iGoodie/monorepo-networker.git"
  },
  "bugs": {
    "url": "https://github.com/iGoodie/monorepo-networker/issues"
  },
  "keywords": [
    "ipc",
    "abstraction",
    "network",
    "message",
    "listener"
  ],
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "main": "./dist/monorepo-networker.umd.cjs",
  "module": "./dist/monorepo-networker.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/monorepo-networker.js",
      "require": "./dist/monorepo-networker.umd.cjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.checks.json",
    "typecheck:examples": "pnpm --filter \"./examples/*\" --recursive typecheck",
    "check": "pnpm typecheck && pnpm typecheck:examples && pnpm test && pnpm build",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  }
}
